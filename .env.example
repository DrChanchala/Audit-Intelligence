# =================================================================
# SiteIQ — Environment Configuration Template
# Copy this file to .env and supply actual secrets for your deployment
# =================================================================

# Server & Runtime Configuration
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Database Configuration (Supabase PostgreSQL / Managed Postgres)
# Direct connection string for pooling / transactional connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Direct connection string for migrations (bypassing connection pooler)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Platform Integration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Public anon key (used in frontend client if needed)
SUPABASE_ANON_KEY=eyJhbGciOi...[YOUR-ANON-KEY]
# Server-side service role key (NEVER expose to frontend; used for backend storage/admin operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[YOUR-SERVICE-ROLE-KEY]
# Supabase Storage bucket for inspection evidence photos
SUPABASE_STORAGE_BUCKET=inspection-evidence

# Google Gemini AI Model Integration
# Required for AI Audit Dossiers and Inspection Executive Summaries
GEMINI_API_KEY=AIzaSy...[YOUR-GEMINI-API-KEY]

# CORS & Application URLs
FRONTEND_URL=https://siteiq-platform.up.railway.app
BACKEND_URL=https://siteiq-platform.up.railway.app
